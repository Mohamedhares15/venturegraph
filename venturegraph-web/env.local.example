# ================================================================
# VentureGraph Web — Environment Variables
# Copy this file to .env.local (gitignored) and fill in values.
# ================================================================

# Supabase — create a free project at https://supabase.com
# Find these in: Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...  # anon/public key

# Public app URL (used for receipt verify links in seal API)
NEXT_PUBLIC_APP_URL=https://venturegraph.vercel.app
